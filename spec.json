    },
    "components": {
        "schemas": {
            "Feature": {
                "title": "Feature",
                "required": [
                    "geometry",
                    "properties",
                    "type"
                ],
                "type": "object",
                "properties": {
                    "geometry": {
                        "$ref": "#/components/schemas/Point"
                    },
                    "properties": {
                        "$ref": "#/components/schemas/Properties"
                    },
                    "type": {
                        "type": "string",
                        "description": "The GeoJSON type identifier",
                        "example": "Feature"
                    }
                },
                "description": "A feature object with mandatory geometry and properties fields"
            },
            "Location": {
                "title": "Location",
                "type": "object",
                "properties": {
                    "licence": {
                        "type": "string",
                        "description": "The licence for the forecast location name",
                        "example": "Data \u00a9 OpenStreetMap contributors, ODbL 1.0. https://osm.org/copyright"
                    },
                    "name": {
                        "type": "string",
                        "description": "The forecast location name",
                        "example": "St Thomas, Devon, South West England, England, GB"
                    }
                }
            },
            "ParameterDetails": {
                "title": "ParameterDetails",
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "unit": {
                        "$ref": "#/components/schemas/Unit"
                    }
                }
            },
            "Point": {
                "title": "Point",
                "required": [
                    "coordinates",
                    "type"
                ],
                "type": "object",
                "properties": {
                    "coordinates": {
                        "type": "array",
                        "description": "The longitude, latitude and elevation values for the point",
                        "items": {
                            "type": "string"
                        }
                    },
                    "type": {
                        "type": "string",
                        "description": "The GeoJSON type identifier",
                        "example": "Point"
                    }
                }
            },
            "Properties": {
                "title": "Properties",
                "required": [
                    "modelRunDate",
                    "requestPointDistance",
                    "timeSeries"
                ],
                "type": "object",
                "properties": {
                    "location": {
                        "$ref": "#/components/schemas/Location"
                    },
                    "modelRunDate": {
                        "type": "string",
                        "description": "The model run date in UTC",
                        "example": "2019-01-31T12:00Z"
                    },
                    "requestPointDistance": {
                        "type": "number",
                        "description": "The distance from the requested point in metres"
                    },
                    "timeSeries": {
                        "type": "object",
                        "properties": {},
                        "description": "A time step ordered list  of forecast parameters and associated values"
                    }
                }
            },
            "SpotForecastFeatureCollection": {
                "title": "SpotForecastFeatureCollection",
                "required": [
                    "features",
                    "parameters",
                    "type"
                ],
                "type": "object",
                "properties": {
                    "features": {
                        "type": "array",
                        "description": "A list of feature objects",
                        "items": {
                            "$ref": "#/components/schemas/Feature"
                        }
                    },
                    "parameters": {
                        "type": "array",
                        "description": "Forecast parameter metadata for all possible forecast parameters in response - each forecast parameter has a nested object containing a unit of measurement, using standard unit representation as defined by UCUM - http://unitsofmeasure.org/ucum.html - and an optional parameter definition",
                        "items": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/components/schemas/ParameterDetails"
                            }
                        }
                    },
                    "type": {
                        "type": "string",
                        "description": "The GeoJSON type identifier",
                        "example": "FeatureCollection"
                    }
                },
                "description": "A feature collection object, must have a member array of features"
            },
            "Symbol": {
                "title": "Symbol",
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            },
            "TimeSeries": {
                "title": "TimeSeries",
                "required": [
                    "time"
                ],
                "type": "object",
                "properties": {
                    "data": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "number"
                        },
                        "description": "A map of forecast parameters and associated values"
                    },
                    "time": {
                        "type": "string",
                        "description": "Time of the forecast in UTC",
                        "example": "2019-01-31T12:00Z"
                    }
                }
            },
            "Unit": {
                "title": "Unit",
                "required": [
                    "label",
                    "symbol"
                ],
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "The name of the unit",
                        "example": "degrees Celsius"
                    },
                    "symbol": {
                        "$ref": "#/components/schemas/Symbol"
                    }
                }
            },
            "VndError": {
                "title": "VndError",
                "type": "object",
                "properties": {
                    "logref": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
          "APIKey": {
            "type": "apiKey",
            "description": "The API Key generated with your Subscription in Weather DataHub, this must be set as 'apikey' in your header.",
            "name": "apikey",
            "in": "header"
          }
        }
    }
}
